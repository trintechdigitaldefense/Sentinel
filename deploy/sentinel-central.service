[Unit]
Description=SENTINEL Central Management Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sentinel
ExecStart=/usr/bin/env python3 -m sentinel_central.server --port 8443 --key CHANGE_ME
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
